{
  // 저장 시 자동 포맷팅 실행
  "editor.formatOnSave": true,

  // 기본 포맷터: Prettier 사용 (JS/TS/JSON 등)
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // 저장 시 자동 실행할 코드 정리 작업
  "editor.codeActionsOnSave": {
    // ESLint 규칙 위반 자동 수정 (프론트엔드 JS/TS)
    "source.fixAll.eslint": "always",

    // Ruff lint 자동 수정 (파이썬 — 미사용 import 제거 등 자동수정 가능 항목)
    "source.fixAll.ruff": "always",

    // 사용하지 않는 import 제거 및 import 정렬
    "source.organizeImports": "always"
  },

  // 들여쓰기 2칸 고정
  "editor.tabSize": 2,

  // Tab 입력 시 공백 사용
  "editor.insertSpaces": true,

  // 파일마다 들여쓰기 자동 감지 비활성화
  "editor.detectIndentation": false,

  // 1초 후 자동 저장
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  // LF 줄바꿈 고정
  // 줄바꿈 문자 (auto: OS에 따라 자동 감지)
  "files.eol": "\n",

  // 줄 끝 공백 제거
  "files.trimTrailingWhitespace": true,

  // 파일 마지막 줄 개행 추가
  // Git diff 품질 향상
  "files.insertFinalNewline": true,

  // JS/TS 자동 import 추천 활성화
  "js/ts.suggest.autoImports": true,

  // ESLint 검사 대상 파일
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // .prettierrc 파일이 있을 때만 Prettier 동작
  // 팀 규칙 강제
  "prettier.requireConfig": true,

  // Python 파일은 Ruff Formatter 사용
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    // 파이썬은 ruff 스코프 키로 명시 (generic source.organizeImports가 Pylance로
    // 라우팅돼 충돌하는 것을 막음). 저장 시: lint 자동수정 + 미사용 import 제거·정렬.
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "always",
      "source.organizeImports.ruff": "always"
    }
  },

  // Python 자동 import 추천 활성화
  // 예: Flask 입력 → from flask import Flask 추천
  "python.analysis.autoImportCompletions": true,

  // GitHub Actions YAML 자동 검증
  "yaml.validate": true,

  // Python 타입 검사
  "python.analysis.typeCheckingMode": "basic",
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.defaultPackageManager": "ms-python.python:pip"
}
